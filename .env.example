# ============================================================================
# EA FC27 WebApp Bot - Environment Variables Template
# ============================================================================
# Kopiere diese Datei auf deinem Ubuntu-Server zu .env:
#   cp .env.example .env
#
# Und trage dort deine tatsächlichen EA-Zugangsdaten ein:
#   nano .env
# ============================================================================

EA_USERNAME="deine-ea-email@example.com"
EA_PASSWORD="dein-ea-passwort"

